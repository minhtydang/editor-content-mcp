# All optional. Without MONGODB_URI the server uses data/articles.json in memory.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=editor_content
REDIS_URL=redis://localhost:6379
# Without a key, summarize_article falls back to a local extractive summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
SUMMARY_TTL_SECONDS=3600
